<body>
<!-- task 0 -->
<section class="task t0">
  <div class="container">
    <span class="task-label">Task 0. Responsive Typography</span>
    <h1>Responsive Typography</h1>
    <h2>Why it matters</h2>
    <p>Text should be comfortable to read on every device. Smaller font on mobile, medium on tablet, larger on desktop.</p>
    <h2>How it works</h2>
    <p>CSS media queries change the font size of headings and paragraphs when the screen width crosses a breakpoint.</p>
  </div>
</section>
<!-- task 1 -->
<section class="task">
  <div class="container">
    <span class="task-label">Task 1. Layout with Media Queries (no Bootstrap classes)</span>
    <div class="t1-wrapper">
      <div class="t1-box">Box 1</div>
      <div class="t1-box">Box 2</div>
      <div class="t1-box">Box 3</div>
    </div>
  </div>
</section>
<!-- task 2 -->
<section class="task">
  <div class="container">
    <span class="task-label">Task 2. Bootstrap Responsive Columns</span>
    <div class="row g-3">
      <div class="col-12 col-md-6 col-lg-4"><div class="col-box bg-danger">Column 1</div></div>
      <div class="col-12 col-md-6 col-lg-4"><div class="col-box bg-primary">Column 2</div></div>
      <div class="col-12 col-md-6 col-lg-4"><div class="col-box bg-success">Column 3</div></div>
    </div>
  </div>
</section>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
